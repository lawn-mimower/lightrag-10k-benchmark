# Copy to .env and fill in. Scripts load it with python-dotenv.

# Mistral API (entity extraction during indexing, RAGAS judge)
MISTRAL_API_KEY=

# Google Gemini API (answer generation, Gemini benchmarks, custom metrics)
GEMINI_API_KEY=
# Some scripts accept GOOGLE_API_KEY as a fallback
GOOGLE_API_KEY=

# Only needed by optimized_ragas_cell.py (OpenAI embeddings)
OPENAI_API_KEY=

# Reranker server used by lightrag_10k_interactive.ipynb (Infinity / Cohere-compatible)
RERANK_MODEL=answerdotai/answerai-colbert-small-v1
RERANK_BINDING_HOST=http://localhost:7997/v1/rerank
RERANK_BINDING_API_KEY="<not-needed>"
