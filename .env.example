# Copy to .env and fill in. Scripts load it with python-dotenv.

# Mistral API (entity extraction during indexing, RAGAS judge)
MISTRAL_API_KEY=

# Google Gemini API (answer generation, Gemini benchmarks, custom metrics)
GEMINI_API_KEY=
# Some scripts accept GOOGLE_API_KEY as a fallback
GOOGLE_API_KEY=

# Only needed by optimized_ragas_cell.py (OpenAI embeddings)
OPENAI_API_KEY=

# Reranker server used by lightrag_10k_interactive.ipynb (Infinity / Cohere-compatible)
RERANK_MODEL=answerdotai/answerai-colbert-small-v1
RERANK_BINDING_HOST=http://localhost:7997/v1/rerank
RERANK_BINDING_API_KEY="<not-needed>"

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown). Leave commented for the published setup.
# ---------------------------------------------------------------------------
# Multimode notebook (lightrag_10k_priority_ticker_models_optimised_multimode.ipynb)
# MISTRAL_BASE_URL=https://api.mistral.ai/v1      # any OpenAI-compatible endpoint
# MISTRAL_MODEL=ministral-14b-2512
# GENERATION_BACKEND=gemini                      # or "openai" to answer with MISTRAL_BASE_URL
# GEMINI_MODEL=gemini-3-flash-preview
# EMBEDDING_MODEL_NAME=intfloat/e5-mistral-7b-instruct
# EMBEDDING_DIM=4096                             # e.g. 1024 for BAAI/bge-large-en-v1.5 on CPU
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# TICKERS=HON,MSI,MRO,CE,HAS,VRSK,BIIB,ROP,CTAS,AMP
# TEST_TICKER=CTAS
# QUERY_MODES=local,global,naive,hybrid,mix
# MAX_QUESTIONS=                                 # e.g. 2 for a smoke run
# MAX_DOC_CHARS=                                 # e.g. 20000 to index only the start of each 10-K

# RAGAS evaluation (notebook cell 7 and batch_ragas_evaluation.py)
# RAGAS_JUDGE_MODEL=ministral-14b-2512
# RAGAS_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# RESULTS_DIR=5_modes_question_wise_results_with_answers/5_modes_question_wise_results_priority_tickers_ALL

# custom_ragas_metrics.py judge
# CUSTOM_RAGAS_MODEL=gemini-2.5-flash

# LightRAG per-call timeouts in seconds (raise them for CPU-only runs)
# LLM_TIMEOUT=180
# EMBEDDING_TIMEOUT=30

# Document parsing scripts: default input directory
# DOCS_DIR=documents
